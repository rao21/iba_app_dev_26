rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This lecture's Todo app has no login yet, so "anyone with the app"
    // is the only audience — open read/write on just this collection,
    // nothing else in the project.
    match /todos/{todoId} {
      allow read, write: if true;
    }
  }
}
